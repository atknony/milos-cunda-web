---
/**
 * Temizlik görevlisi sayfası — bugün çıkış yapacak (dolayısıyla 11:00'den
 * sonra temizlenmesi gereken) odaların salt-okunur, sade listesi.
 * Tamamen sunucu tarafında render edilir (istemci tarafı veri çağrısı yok) —
 * "cleaner" rolü bu tek sayfaya erişebilir (bkz. src/middleware.ts).
 */
import AdminLayout from "@layouts/AdminLayout.astro";
import { createSupabaseAdminClient } from "@/lib/supabase/admin";
import { getSessionUser } from "@/lib/supabase/server";
import { roleOf } from "@/lib/pms/roles";
import { CHECK_IN_TIME, CHECK_OUT_TIME, todayInHotelTz } from "@/lib/pms/dates";
import type { Reservation, Room } from "@/lib/supabase/types";

export const prerender = false;

const user = await getSessionUser(Astro.request, Astro.cookies);
const role = roleOf(user);

const today = todayInHotelTz();
const supabase = createSupabaseAdminClient();

const [{ data: rooms, error: roomsError }, { data: departures, error: depError }, { data: arrivals }] =
  await Promise.all([
    supabase.from("rooms").select("*").order("sort_order").order("name"),
    supabase.from("reservations").select("*").eq("check_out", today).eq("status", "confirmed"),
    supabase.from("reservations").select("room_id").eq("check_in", today).eq("status", "confirmed"),
  ]);

const error = roomsError ?? depError;

const roomById = new Map(((rooms ?? []) as Room[]).map((r) => [r.id, r]));
const arrivingRoomIds = new Set(((arrivals ?? []) as { room_id: string }[]).map((a) => a.room_id));

const items = ((departures ?? []) as Reservation[])
  .map((r) => ({ reservation: r, room: roomById.get(r.room_id), turnover: arrivingRoomIds.has(r.room_id) }))
  .filter((i): i is typeof i & { room: Room } => !!i.room?.is_active)
  .sort((a, b) => a.room.sort_order - b.room.sort_order);

const WEEKDAYS_FULL_TR = ["Pazartesi", "Salı", "Çarşamba", "Perşembe", "Cuma", "Cumartesi", "Pazar"];
const MONTHS_TR = [
  "Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran",
  "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık",
];
function formatLong(iso: string): string {
  const [y, m, d] = iso.split("-").map(Number);
  const wd = new Date(`${iso}T12:00:00Z`).getUTCDay();
  return `${d} ${MONTHS_TR[m - 1]} ${y} · ${WEEKDAYS_FULL_TR[(wd + 6) % 7]}`;
}
---

<AdminLayout title="Temizlik" active="cleaning" role={role}>
  <h1 class="mb-1 font-serif text-2xl font-bold">Bugün Çıkış Yapacak Odalar</h1>
  <p class="mb-4 text-sm text-stone-500">{formatLong(today)}</p>

  {
    error ? (
      <p class="text-sm text-red-600">Liste yüklenemedi: {error.message}</p>
    ) : items.length === 0 ? (
      <p class="rounded-xl border border-stone-200 bg-white p-8 text-center text-stone-500">
        Bugün çıkış yok — temizlenecek oda bulunmuyor. 🎉
      </p>
    ) : (
      <ul class="space-y-2">
        {items.map(({ reservation, room, turnover }) => (
          <li
            class:list={[
              "rounded-xl border bg-white px-4 py-4",
              turnover ? "border-terra-300" : "border-stone-200",
            ]}
          >
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="text-lg font-semibold text-stone-800">{room.name}</p>
                {reservation.guest_name && (
                  <p class="truncate text-sm text-stone-400">{reservation.guest_name}</p>
                )}
              </div>
              <span class="shrink-0 rounded-full bg-stone-100 px-3 py-1 text-xs font-semibold text-stone-600">
                Çıkış · {CHECK_OUT_TIME}
              </span>
            </div>
            {turnover && (
              <p class="mt-2.5 rounded-lg bg-terra-50 px-3 py-2 text-xs font-semibold text-terra-700">
                ⚡ Bugün aynı odaya yeni misafir giriyor — {CHECK_IN_TIME}'e kadar hazır olmalı
              </p>
            )}
          </li>
        ))}
      </ul>
    )
  }
</AdminLayout>
