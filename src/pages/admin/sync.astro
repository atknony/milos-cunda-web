---
import AdminLayout from "@layouts/AdminLayout.astro";
import FeedManager from "@/components/admin/FeedManager.tsx";
import { createSupabaseAdminClient } from "@/lib/supabase/admin";
import type { IcalFeed, Room, SyncLog } from "@/lib/supabase/types";

export const prerender = false;

const supabase = createSupabaseAdminClient();
const [{ data: rooms }, { data: feeds }, { data: logs }] = await Promise.all([
  supabase.from("rooms").select("*").order("sort_order").order("name"),
  supabase.from("ical_feeds").select("*").order("created_at"),
  supabase.from("sync_logs").select("*").order("ran_at", { ascending: false }).limit(20),
]);

const feedById = new Map(((feeds ?? []) as IcalFeed[]).map((f) => [f.id, f]));
const roomById = new Map(((rooms ?? []) as Room[]).map((r) => [r.id, r]));

function describeFeed(feedId: string | null): string {
  if (!feedId) return "—";
  const feed = feedById.get(feedId);
  if (!feed) return "silinmiş besleme";
  return `${roomById.get(feed.room_id)?.name ?? "?"} · ${feed.platform}`;
}

function formatDateTime(iso: string): string {
  return new Intl.DateTimeFormat("tr-TR", {
    dateStyle: "short",
    timeStyle: "medium",
    timeZone: "Europe/Istanbul",
  }).format(new Date(iso));
}
---

<AdminLayout title="Senkronizasyon" active="sync">
  <h1 class="mb-4 font-serif text-2xl font-bold">Senkronizasyon</h1>

  <FeedManager client:load rooms={(rooms ?? []) as Room[]} initialFeeds={(feeds ?? []) as IcalFeed[]} />

  <section class="mt-8">
    <h2 class="mb-2 font-serif text-lg font-bold">Otomatik senkronizasyon (cron)</h2>
    <div class="rounded-xl border border-stone-200 bg-white p-4 text-sm leading-relaxed text-stone-600">
      <p>
        Dış takvimlerin otomatik okunması için
        <a href="https://cron-job.org" target="_blank" rel="noopener" class="text-aegean-700 underline">cron-job.org</a>
        üzerinde <strong>15 dakikada bir</strong> çalışan ücretsiz bir görev oluşturun:
      </p>
      <code class="mt-2 block rounded bg-stone-100 px-3 py-2 text-xs">
        GET {Astro.url.origin}/api/sync/import?token=CRON_SECRET_DEGERINIZ
      </code>
      <p class="mt-2 text-xs text-stone-400">
        token değeri Vercel ortam değişkenlerindeki CRON_SECRET ile aynı olmalıdır.
      </p>
    </div>
  </section>

  <section class="mt-8">
    <h2 class="mb-2 font-serif text-lg font-bold">Son senkronizasyon kayıtları</h2>
    <div class="overflow-hidden rounded-xl border border-stone-200 bg-white">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-stone-200 bg-stone-50 text-left text-xs uppercase tracking-wide text-stone-500">
            <th class="px-4 py-2">Zaman</th>
            <th class="px-4 py-2">Tetik</th>
            <th class="px-4 py-2">Besleme</th>
            <th class="px-4 py-2">Bulunan</th>
            <th class="px-4 py-2">Yeni</th>
            <th class="px-4 py-2">Güncel</th>
            <th class="px-4 py-2">İptal</th>
            <th class="px-4 py-2">Çakışma</th>
            <th class="px-4 py-2">Hata</th>
          </tr>
        </thead>
        <tbody>
          {
            (logs ?? []).length === 0 ? (
              <tr>
                <td colspan="9" class="px-4 py-6 text-center text-stone-400">
                  Henüz senkronizasyon çalışmadı.
                </td>
              </tr>
            ) : (
              ((logs ?? []) as SyncLog[]).map((log) => (
                <tr class="border-b border-stone-100">
                  <td class="px-4 py-2 text-xs">{formatDateTime(log.ran_at)}</td>
                  <td class="px-4 py-2 text-xs">{log.trigger === "cron" ? "Cron" : "Elle"}</td>
                  <td class="px-4 py-2 text-xs">{describeFeed(log.feed_id)}</td>
                  <td class="px-4 py-2">{log.events_found}</td>
                  <td class="px-4 py-2">{log.created}</td>
                  <td class="px-4 py-2">{log.updated}</td>
                  <td class="px-4 py-2">{log.cancelled}</td>
                  <td class="px-4 py-2">{log.conflicts}</td>
                  <td class="px-4 py-2 text-xs text-red-600">{log.error ?? ""}</td>
                </tr>
              ))
            )
          }
        </tbody>
      </table>
    </div>
  </section>
</AdminLayout>
