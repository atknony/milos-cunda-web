---
/**
 * Cunda Milos — About / Hakkımızda
 * Route: /[lang]/about/
 *
 * Brand-entity page: the story of the house, the family, and the
 * direct-only booking philosophy. Emits AboutPage JSON-LD whose
 * mainEntity is the sitewide Hotel node (see Hotel.subjectOf).
 */

import type { GetStaticPaths } from "astro";
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import { languages, type Lang } from "../../i18n/ui";
import { useTranslations, getLocalizedPath, getWhatsAppUrl, getPhoneUrl } from "../../i18n/utils";
import { generateAboutPageSchema } from "../../lib/schema";
import { story } from "../../i18n/story";

export const getStaticPaths = (() => {
  return (Object.keys(languages) as Lang[]).map((lang) => ({
    params: { lang },
  }));
}) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const whatsappUrl = getWhatsAppUrl(lang);
const phoneUrl = getPhoneUrl();

/**
 * Feature blocks.
 *
 * The former standalone "Experience" page was merged into this page
 * (2026-08); its blocks continue the same alternating layout and the
 * numbering runs unbroken across both groups. `heading` on a block
 * renders a section header immediately before it.
 */
const blocks = [
  {
    titleKey: "about.story.title" as const,
    textKey: "about.story.text" as const,
    image: "/images/gallery/exterior-facade.jpg",
    alt: { tr: "Cunda Milos — 1907 tarihli Rum taş evi cephesi, Cunda Adası Ayvalık", en: "Cunda Milos — facade of the 1907 Greek stone house, Cunda Island, Ayvalık", el: "Cunda Milos — πρόσοψη του πέτρινου σπιτιού του 1907, Κούνδα, Αϊβαλί" },
  },
  {
    heading: true,
    titleKey: "experience.breakfast.title" as const,
    textKey: "experience.breakfast.text" as const,
    noticeKey: "experience.breakfast.notice" as const,
    image: "/images/experience/breakfast.jpg",
    alt: { tr: "Kahvaltı terası — taş duvarın önündeki masalar", en: "Breakfast terrace — tables set against the stone wall", el: "Βεράντα πρωινού — τραπέζια μπροστά στον πέτρινο τοίχο" },
  },
  {
    titleKey: "experience.garden.title" as const,
    textKey: "experience.garden.text" as const,
    image: "/images/experience/courtyard.jpg",
    alt: { tr: "Milos Bahçe — çam ağaçları ve begonvillerle çevrili bahçe", en: "The Milos Garden — framed by pines and bougainvillea", el: "Ο Κήπος Milos — πλαισιωμένος από πεύκα και βουκαμβίλιες" },
  },
  {
    titleKey: "experience.architecture.title" as const,
    textKey: "experience.architecture.text" as const,
    image: "/images/rooms/numara-1/bedroom.jpg",
    alt: { tr: "1907 tarihli evin korunmuş taş duvarları ve ahşap tavanı", en: "Preserved stone walls and timber ceiling of the 1907 house", el: "Διατηρημένοι πέτρινοι τοίχοι και ξύλινη οροφή του σπιτιού του 1907" },
  },
];

/* ─── SEO ─── */
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://cundamilos.com";
const breadcrumbs = [
  { name: "Cunda Milos", url: `${siteUrl}/${lang}/` },
  { name: t("about.title"), url: `${siteUrl}${getLocalizedPath(lang, "about")}` },
];

const aboutSchema = generateAboutPageSchema(lang, t("about.title"), t("about.metaDescription"));

/* Blocks from here on sit under the "Milos Deneyimi" h2, so their titles
   drop a level to h3 to keep the heading outline unbroken. */
const expStart = blocks.findIndex((b) => b.heading);

/* The journalist's long-form piece on the house, rendered below the
   experience blocks. See src/i18n/story.ts. */
const article = story[lang];
---

<MainLayout
  title={t("about.metaTitle")}
  description={t("about.metaDescription")}
  breadcrumbs={breadcrumbs}
  additionalSchemas={[aboutSchema]}
>
  <Header slot="header" />

  <!-- ─── Page Header ─── -->
  <section class="pt-32 lg:pt-40 pb-16 lg:pb-24 bg-stone-50">
    <div class="container-narrow text-center">
      <div class="line-accent mx-auto mb-6 hero-stagger-1" aria-hidden="true"></div>
      <h1 class="text-display text-stone-900 mb-5 hero-stagger-2" data-speakable-name>
        {t("about.title")}
      </h1>
      <p class="text-stone-500 text-lg sm:text-xl leading-relaxed max-w-xl mx-auto hero-stagger-3">
        {t("about.subtitle")}
      </p>
    </div>
  </section>

  <!-- ─── Intro prose (crawlable brand statement) ─── -->
  <section class="bg-stone-50 pb-16 lg:pb-20">
    <div class="container-narrow">
      <p class="reveal text-stone-600 text-base sm:text-lg leading-[1.85] max-w-2xl mx-auto text-center" data-speakable-desc>
        {t("home.intro.text")}
      </p>
    </div>
  </section>

  <!-- ─── Story Blocks ─── -->
  <section class="bg-stone-50 pb-16 lg:pb-24">
    <div class="container-wide flex flex-col gap-10 lg:gap-14">
      {blocks.map((block, i) => {
        const isReversed = i % 2 === 1;
        const num = String(i + 1).padStart(2, "0");
        const Title = i >= expStart ? "h3" : "h2";
        return (
          <>
            {block.heading && (
              <div class="reveal text-center max-w-xl mx-auto pt-6 lg:pt-10">
                <div class="line-accent mx-auto mb-6" aria-hidden="true"></div>
                <h2 class="font-serif text-3xl lg:text-4xl text-stone-900 mb-4">
                  {t("section.experience.title")}
                </h2>
                <p class="text-stone-500 text-base sm:text-lg leading-relaxed">
                  {t("experience.subtitle")}
                </p>
              </div>
            )}
            <div
              class:list={["exp-block reveal", isReversed && "exp-block-reverse"]}
              style={`transition-delay: ${i * 0.08}s`}
            >
              <div class="aspect-[4/3] lg:aspect-auto overflow-hidden">
                <img
                  src={block.image}
                  alt={block.alt[lang]}
                  width="900"
                  height="675"
                  loading={i === 0 ? "eager" : "lazy"}
                  decoding="async"
                  class="img-cover img-warm"
                />
              </div>
              <div class="relative p-8 lg:p-12 xl:p-16 flex flex-col justify-center">
                <span class="exp-number" aria-hidden="true">{num}</span>
                <div class="relative z-10">
                  <div class="line-accent mb-5" aria-hidden="true"></div>
                  <Title class="font-serif text-2xl lg:text-3xl text-stone-900 mb-5">
                    {t(block.titleKey)}
                  </Title>
                  {block.noticeKey && (
                    <p class="notice-tag mb-5">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                           stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                           class="shrink-0" aria-hidden="true">
                        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                        <path d="M12 9v4" /><path d="M12 17h.01" />
                      </svg>
                      {t(block.noticeKey)}
                    </p>
                  )}
                  <p class="text-stone-600 text-base lg:text-lg leading-[1.85] max-w-md">
                    {t(block.textKey)}
                  </p>
                </div>
              </div>
            </div>
          </>
        );
      })}
    </div>
  </section>

  <!-- ─── The House's Story (long-form editorial) ─── -->
  <section class="bg-stone-100/50 py-20 lg:py-28 overflow-hidden">
    <div class="container-narrow">
      <article>
        <!-- Masthead -->
        <header class="story-measure reveal text-center mb-14 lg:mb-20">
          <span class="story-kicker">{article.kicker}</span>
          <h2 class="story-title">{article.title}</h2>
          <p class="story-subtitle">{article.subtitle}</p>
        </header>

        <!-- Standfirst -->
        <div class="story-measure reveal">
          <p class="story-lead">{article.lead}</p>
        </div>

        <!-- Body -->
        <div class="story-body">
          {article.blocks.map((block) => {
            if (block.kind === "figure") {
              return (
                <figure class="story-figure reveal">
                  <img
                    src={block.image}
                    alt={block.alt}
                    width="1600"
                    height="1200"
                    loading="lazy"
                    decoding="async"
                    class="img-warm"
                  />
                  <figcaption>{block.caption}</figcaption>
                </figure>
              );
            }
            if (block.kind === "pull") {
              return (
                <div class="story-measure reveal">
                  <p class="story-pull">{block.text}</p>
                </div>
              );
            }
            if (block.kind === "verse") {
              return (
                <div class="story-measure">
                  <blockquote class="story-verse">
                    <p>
                      {block.lines.map((line, i) => (
                        <>
                          {i > 0 && <br />}
                          {line}
                        </>
                      ))}
                    </p>
                    {block.translation && (
                      <p class="story-verse-translation">{block.translation}</p>
                    )}
                  </blockquote>
                </div>
              );
            }
            if (block.kind === "h") {
              return (
                <div class="story-measure">
                  <h3>{block.text}</h3>
                </div>
              );
            }
            if (block.kind === "closing") {
              return (
                <div class="story-measure">
                  <p class="story-closing">{block.text}</p>
                </div>
              );
            }
            return (
              <div class="story-measure">
                <p>{block.text}</p>
              </div>
            );
          })}
        </div>

        <!-- Byline -->
        <footer class="story-measure reveal story-byline">
          <cite class="story-byline-name not-italic">{article.author}</cite>
          <span class="story-byline-role">{article.authorRole}</span>
        </footer>
      </article>
    </div>
  </section>

  <!-- ─── Booking CTA ─── -->
  <section class="bg-stone-900 text-stone-50 py-20 lg:py-28">
    <div class="container-narrow text-center">
      <div class="reveal">
        <div class="line-accent mx-auto mb-6 !bg-olive-400/50" aria-hidden="true"></div>
        <h2 class="font-serif text-3xl lg:text-4xl text-stone-50 mb-4">
          {t("hero.tagline")}
        </h2>
        <p class="text-stone-400 text-base sm:text-lg mb-10 max-w-md mx-auto">
          {t("hero.subtitle")}
        </p>
        <div class="flex flex-wrap items-center justify-center gap-5">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-8 py-4
                   bg-stone-50 hover:bg-white text-stone-900
                   text-[0.7rem] font-medium tracking-[0.18em] uppercase
                   rounded-[2px] transition-colors duration-300"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
            </svg>
            {t("cta.whatsapp")}
          </a>
          <a
            href={phoneUrl}
            class="inline-flex items-center gap-2 text-[0.7rem] font-medium tracking-[0.18em]
                   uppercase text-stone-400 hover:text-stone-50
                   border border-stone-700 hover:border-stone-400
                   rounded-[2px] px-8 py-4 transition-all duration-300"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            {t("cta.call")}
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</MainLayout>
