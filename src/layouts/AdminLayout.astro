---
/**
 * PMS panel iskeleti — Türkçe, noindex, site i18n sisteminden bağımsız.
 * Mobil öncelikli: küçük ekranda alt sekme çubuğu, geniş ekranda üst menü.
 */
import "@styles/global.css";
import type { StaffRole } from "@/lib/pms/roles";

interface Props {
  title: string;
  /** Aktif menü öğesi vurgusu için */
  active?: "dashboard" | "rooms" | "reservations" | "cleaning";
  /** "cleaner" rolünde yalnızca Temizlik sekmesi gösterilir (tek sayfaya erişimleri var). */
  role?: StaffRole;
}

const { title, active, role = "admin" } = Astro.props;
const home = role === "cleaner" ? "/admin/cleaning" : "/admin";

const nav =
  role === "cleaner"
    ? ([{ key: "cleaning", href: "/admin/cleaning", label: "Temizlik", icon: "sparkle" }] as const)
    : ([
        { key: "dashboard", href: "/admin", label: "Takvim", icon: "calendar" },
        { key: "reservations", href: "/admin/reservations", label: "Rezervasyonlar", icon: "list" },
        { key: "rooms", href: "/admin/rooms", label: "Odalar", icon: "bed" },
        { key: "cleaning", href: "/admin/cleaning", label: "Temizlik", icon: "sparkle" },
      ] as const);

const icons: Record<string, string> = {
  calendar:
    "M8 2v3M16 2v3M3.5 9h17M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z",
  list: "M4 6h16M4 12h16M4 18h10",
  bed: "M3 18v-6a2 2 0 0 1 2-2h6v5M3 18h18v-3a2 2 0 0 0-2-2h-6M3 18v2M21 18v2M13 15h6a2 2 0 0 1 2 2v1",
  sparkle:
    "M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2 2M16 16l2 2M18 6l-2 2M8 16l-2 2M12 8l1.5 3.5L17 13l-3.5 1.5L12 18l-1.5-3.5L7 13l3.5-1.5Z",
};
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Cunda Milos Panel</title>
  </head>
  <body class="min-h-screen bg-stone-100 pb-20 text-stone-900 antialiased sm:pb-0">
    <!-- Üst çubuk: marka + çıkış (her ekran boyutunda) -->
    <header class="sticky top-0 z-30 border-b border-stone-200 bg-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3">
        <a href={home} class="font-serif text-lg font-bold tracking-tight">
          Cunda Milos <span class="font-sans text-xs font-normal text-stone-500">PANEL</span>
        </a>

        <!-- Geniş ekranda yatay menü -->
        <nav class="hidden items-center gap-1 text-sm sm:flex">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "rounded-md px-4 py-2 font-medium transition-colors",
                  active === item.key
                    ? "bg-stone-900 text-white"
                    : "text-stone-600 hover:bg-stone-100 hover:text-stone-900",
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <form method="post" action="/api/auth/logout">
          <button
            type="submit"
            class="rounded-md px-3 py-2 text-sm font-medium text-stone-400 transition-colors hover:bg-red-50 hover:text-red-600"
          >
            Çıkış
          </button>
        </form>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-3 py-4 sm:px-4 sm:py-6">
      <slot />
    </main>

    <!-- Alt sekme çubuğu: yalnızca mobilde — büyük dokunma alanları -->
    <nav
      class="fixed inset-x-0 bottom-0 z-30 flex border-t border-stone-200 bg-white pb-[env(safe-area-inset-bottom)] sm:hidden"
      aria-label="Panel gezinme"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "flex flex-1 flex-col items-center gap-1 py-2.5 text-xs font-medium transition-colors",
              active === item.key ? "text-stone-900" : "text-stone-400",
            ]}
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width={active === item.key ? 2.25 : 1.75}
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-6 w-6"
            >
              <path d={icons[item.icon]} />
            </svg>
            {item.label}
          </a>
        ))
      }
    </nav>
  </body>
</html>
